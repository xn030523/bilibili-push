{
  "name": "aihot-bili",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "start": "npm run build:web && tsx src/server/server.ts",
    "collect": "tsx src/index.ts",
    "gen-props": "tsx src/video/gen-props.ts",
    "render": "remotion render AihotDaily output/final.mp4 --props=output/props.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@remotion/cli": "^4.0.544",
    "antd": "^6.7.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.544",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
